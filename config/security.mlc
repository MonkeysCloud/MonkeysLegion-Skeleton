# ═══════════════════════════════════════════════════════════════════════════════
# MonKeysLegion Security Configuration
# ═══════════════════════════════════════════════════════════════════════════════

security {

    # ── Security Headers ──────────────────────────────────────────────────────
    # Preset: strict | relaxed | api
    headers {
        preset          = ${SECURITY_HEADERS_PRESET:"strict"}
        hsts_max_age    = 63072000
        hsts_subdomains = true
        hsts_preload    = true
        frame_options   = "DENY"
        content_type    = "nosniff"
        referrer_policy = "strict-origin-when-cross-origin"
        permissions_policy = "camera=(), microphone=(), geolocation=(), payment=()"
    }

    # ── Content Security Policy ───────────────────────────────────────────────
    # Directive keys use underscores (MLC keys cannot contain hyphens).
    # The {nonce} placeholder is replaced per-request with a random nonce.
    csp {
        enabled     = ${CSP_ENABLED:true}
        report_only = ${CSP_REPORT_ONLY:false}

        directives {
            default_src     = "'self'"
            script_src      = "'self' {nonce} 'strict-dynamic'"
            style_src       = "'self' {nonce}"
            img_src         = "'self' data:"
            connect_src     = "'self'"
            font_src        = "'self'"
            object_src      = "'none'"
            base_uri        = "'self'"
            frame_ancestors = "'none'"
            form_action     = "'self'"
        }

        # URL to send violation reports to (optional)
        report_uri = ${CSP_REPORT_URI:""}
    }

    # ── CSRF Protection ───────────────────────────────────────────────────────
    csrf {
        enabled      = ${CSRF_ENABLED:true}
        # Stateful CSRF (session-based) or stateless (double-submit cookie)
        mode         = ${CSRF_MODE:"stateless"}
        token_field  = "_csrf"
        header_name  = "X-CSRF-Token"
        cookie_name  = "csrf_token"
        token_length = 32
        secure_cookie = ${CSRF_SECURE_COOKIE:true}
        # URI prefixes that bypass CSRF (e.g. API endpoints using JWT)
        except = ["/api/"]
    }

    # ── Password Security ─────────────────────────────────────────────────────
    password {
        # Argon2id parameters
        algorithm     = "argon2id"
        memory_cost   = 65536
        time_cost     = 4
        threads       = 1
        bcrypt_cost   = 12

        # Pwned Passwords (HIBP API)
        pwned_check   = ${PWNED_CHECK_ENABLED:false}
        pwned_threshold = 1  # Reject if password appears N+ times
        pwned_cache_ttl = 86400  # 24 hours
    }

    # ── Audit Logging ─────────────────────────────────────────────────────────
    audit {
        enabled  = ${AUDIT_LOG_ENABLED:true}
        log_path = "storage/logs/audit"
        # Drivers: file | database
        driver   = "file"
    }

    # ── Signed URLs ───────────────────────────────────────────────────────────
    signed_urls {
        # URI prefixes that require a valid signature
        protected = ["/verify-email", "/reset-password", "/unsubscribe/"]
    }

    # ── GDPR ──────────────────────────────────────────────────────────────────
    gdpr {
        enabled = ${GDPR_ENABLED:false}
        # Anonymize strategy: anonymize | delete
        default_strategy = "anonymize"
    }

    # ── SQL Injection Guard ───────────────────────────────────────────────────
    sql_guard {
        enabled = ${SQL_GUARD_ENABLED:true}
        # Reject raw SQL with variable interpolation patterns
        reject_interpolation = true
    }
}
