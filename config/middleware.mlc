# ═══════════════════════════════════════════════════════════════════════════════
# Middleware Pipeline — MonKeysLegion v2.1
# ═══════════════════════════════════════════════════════════════════════════════
#
# Global PSR-15 middleware pipeline — order matters (first runs first).
# All classes MUST implement Psr\Http\Server\MiddlewareInterface.

middleware {
    global = [
        "MonkeysLegion\\Http\\Middleware\\RequestIdMiddleware",
        "MonkeysLegion\\Http\\Middleware\\CorrelationIdMiddleware",
        "MonkeysLegion\\Http\\Middleware\\SecurityHeadersMiddleware",
        "MonkeysLegion\\Http\\Middleware\\CspMiddleware",
        "MonkeysLegion\\Framework\\Middleware\\MaintenanceModeMiddleware",
        "MonkeysLegion\\Http\\Middleware\\ErrorHandlerMiddleware",
        "MonkeysLegion\\Http\\Middleware\\LoggingMiddleware",
        "MonkeysLegion\\Http\\Middleware\\CorsMiddleware",
        "MonkeysLegion\\Http\\Middleware\\RateLimitMiddleware",
        "MonkeysLegion\\Session\\Middleware\\SessionMiddleware",
        "MonkeysLegion\\Session\\Middleware\\VerifyCsrfToken",
        "MonkeysLegion\\Auth\\Middleware\\AuthenticationMiddleware",
        "MonkeysLegion\\Http\\Middleware\\ConditionalMiddleware",
        "MonkeysLegion\\Http\\Middleware\\CompressionMiddleware",
        "MonkeysLegion\\Telemetry\\Middleware\\RequestMetricsMiddleware",
    ]

    # ─── Route-level Middleware Aliases ────────────────────────────────────────
    # Shorthand aliases usable in #[Middleware(['auth', 'throttle:60,1'])]
    aliases {
        auth       = "MonkeysLegion\\Auth\\Middleware\\AuthenticationMiddleware"
        csrf       = "MonkeysLegion\\Session\\Middleware\\VerifyCsrfToken"
        throttle   = "MonkeysLegion\\Http\\Middleware\\RateLimitMiddleware"
        cors       = "MonkeysLegion\\Http\\Middleware\\CorsMiddleware"
        csp        = "MonkeysLegion\\Http\\Middleware\\CspMiddleware"
        signed     = "MonkeysLegion\\Http\\Middleware\\SignedUrlMiddleware"
        deprecated = "MonkeysLegion\\Http\\Middleware\\DeprecationMiddleware"
        inertia    = "MonkeysLegion\\Inertia\\InertiaMiddleware"
        feature    = "MonkeysLegion\\FeatureFlags\\Middleware\\FeatureFlagMiddleware"
        webhook    = "MonkeysLegion\\Webhooks\\Middleware\\VerifyWebhookSignatureMiddleware"
    }
}

# ─── Rate limiting ────────────────────────────────────────────────────────────
rate_limit {
    max_requests   = 5000
    window_seconds = 60
}

# ─── Maintenance mode bypass ──────────────────────────────────────────────────
maintenance {
    allowed_ips = []
    secret      = ${MAINTENANCE_SECRET:""}
}
