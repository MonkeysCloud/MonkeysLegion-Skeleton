###############################################################################
#  MonkeysLegion v2 — Docker Environment Reference                             #
#                                                                             #
#  This file documents all Docker-specific environment variables.             #
#  Copy relevant values into your .env when running with Docker Compose.      #
#  This file is safe to commit — it contains no secrets.                      #
###############################################################################

# ═══════════════════════════════════════════════════════════════════════════════
# Application
# ═══════════════════════════════════════════════════════════════════════════════

APP_NAME="MonkeysLegion App"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
# APP_KEY is generated by: docker compose exec app php bin/ml key:generate

# ═══════════════════════════════════════════════════════════════════════════════
# Database — PostgreSQL (service name: postgres)
# ═══════════════════════════════════════════════════════════════════════════════

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ml_skeleton
DB_USERNAME=ml
DB_PASSWORD=ml_secret
DB_CHARSET=utf8

# ═══════════════════════════════════════════════════════════════════════════════
# Redis (service name: redis) — cache, session, queue
# ═══════════════════════════════════════════════════════════════════════════════

REDIS_HOST=redis
REDIS_PORT=6379

# ═══════════════════════════════════════════════════════════════════════════════
# Cache, Session, Queue — all backed by Redis
# ═══════════════════════════════════════════════════════════════════════════════

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_DEFAULT=redis
FEATURE_FLAGS_DRIVER=redis

# ═══════════════════════════════════════════════════════════════════════════════
# Search — Meilisearch (service name: meilisearch)
# ═══════════════════════════════════════════════════════════════════════════════

SEARCH_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# Mail — Mailpit (service name: mailpit)
# ═══════════════════════════════════════════════════════════════════════════════

MAIL_DRIVER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ═══════════════════════════════════════════════════════════════════════════════
# Vite Dev Server
# ═══════════════════════════════════════════════════════════════════════════════
# The Vite dev server runs on port 5173 inside the 'node' container.
# The browser accesses it at http://localhost:5173 (exposed port).
# The PHP framework references this URL from config/vite.mlc.

# ═══════════════════════════════════════════════════════════════════════════════
# Service Port Mapping (host → container)
# ═══════════════════════════════════════════════════════════════════════════════
#
#   8000  → nginx      (PHP app)
#   5173  → node       (Vite dev server / HMR)
#   5432  → postgres   (PostgreSQL)
#   6379  → redis      (Redis)
#   7700  → meilisearch (Meilisearch dashboard)
#   8025  → mailpit    (Mailpit web inbox)
#   1025  → mailpit    (Mailpit SMTP)
#   8080  → adminer    (Adminer DB UI)
#
###############################################################################
